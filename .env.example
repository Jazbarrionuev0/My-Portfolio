# Neon pooled connection for the running application (hostname contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Neon direct connection for Prisma migrations and schema inspection.
DIRECT_URL="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DB?sslmode=require"

# Use CLOUDINARY_URL, or the three CLOUDINARY_* variables below.
CLOUDINARY_URL=""
# Example: CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# Set to fixed only for a legacy fixed-folder Cloudinary product environment.
# CLOUDINARY_FOLDER_MODE="fixed"
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

ADMIN_PASSWORD=""
JWT_SECRET=""
